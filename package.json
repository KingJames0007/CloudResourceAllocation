{
  "name": "cloud-resource-allocation-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:wasm": "em++ -std=c++17 -O3 -Icore-engine/include --bind core-engine/src/wasm_bindings.cpp -s WASM=1 -s MODULARIZE=1 -s EXPORT_ES6=1 -s EXPORT_NAME=createStratosModule -s ALLOW_MEMORY_GROWTH=1 -o src/wasm/stratos_engine.js"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.1.1"
  }
}
